# Leave PLAID_* empty to run in DEMO MODE with realistic fake data.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Free key at https://finnhub.io — empty = demo stock prices
FINNHUB_API_KEY=

# Powers the chatbot: set ONE. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# SQLite by default; swap for Postgres/Supabase: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./finance.db
