# Copy this file to .streamlit/secrets.toml and fill in what you have.
# secrets.toml is gitignored. NEVER commit real keys. Everything is optional; empty = demo mode.
# In GitHub Codespaces, add these as Codespaces secrets instead (Settings > Secrets > Codespaces).

# AI assistant: set ONE of these.
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
# Paid alternative: https://console.anthropic.com
ANTHROPIC_API_KEY = ""

# Fake bank data: https://dashboard.plaid.com (use your SANDBOX secret)
PLAID_CLIENT_ID = ""
PLAID_SECRET = ""
PLAID_ENV = "sandbox"

# Required once Plaid is on. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY = ""

# Live stock prices: https://finnhub.io
FINNHUB_API_KEY = ""
