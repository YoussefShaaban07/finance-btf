# Event 2 style setup. Copy this file to .env, then paste your SANDBOX keys after the = signs.
# Find them at dashboard.plaid.com > Developers > Keys. No quotes, no spaces.
# .env is gitignored. Run `git status` after creating it: .env must NOT appear in the list.
#
# (You can use .streamlit/secrets.toml instead; it works the same. Don't put the same key in both.)
PLAID_CLIENT_ID=
PLAID_SECRET=

# Needed to store the bank connection encrypted. Generate one with:
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: the AI assistant (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
